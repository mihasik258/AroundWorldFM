PROJECT_NAME="AroundFM API"
API_V1_STR="/api/v1"

# Security — обязательны, значений по умолчанию нет. Сгенерировать: openssl rand -hex 32
# SECRET_KEY не короче 32 байт (иначе приложение не запустится)
SECRET_KEY=""
SECRET_PEPPER=""

# JWT expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Refresh-токен хранится в httpOnly cookie с флагом Secure.
# Браузеры принимают Secure-cookie на http://localhost; false — только для
# HTTP-доступа по другому адресу (например, по IP в локальной сети) при разработке.
COOKIE_SECURE=true
# Сколько секунд после ротации старый refresh-токен ещё принимается (гонка двух вкладок)
REFRESH_REUSE_GRACE_SECONDS=30

# Database URL (PostgreSQL 16)
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/aroundfm"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

