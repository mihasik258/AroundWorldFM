PROJECT_NAME="AroundFM API"
API_V1_STR="/api/v1"

# Security (Обязательно смените в production!)
SECRET_KEY="replace-this-with-a-very-secure-random-jwt-secret-key"
SECRET_PEPPER="replace-this-with-a-secret-pepper-phrase-stored-outside-db"

# JWT expiration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database URL (PostgreSQL 16)
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/aroundfm"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

